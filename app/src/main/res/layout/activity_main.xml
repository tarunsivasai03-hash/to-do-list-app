<?xml version="1.0" encoding="utf-8"?>
<!--
    Main Activity Layout — The home screen of the Notes app.

    Structure:
    - CoordinatorLayout (root — enables FAB behavior and Snackbar anchoring)
      - LinearLayout (vertical container)
        - MaterialToolbar (app title + menu)
        - Search bar (EditText with icons)
        - ChipGroup (category filters)
        - Result Count Header
        - FrameLayout (holds both RecyclerView and empty state)
          - RecyclerView (notes list)
          - Empty state (shown when no notes)
      - FloatingActionButton (add note)
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".activities.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ============================================== -->
        <!-- Toolbar                                        -->
        <!-- ============================================== -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="@color/toolbar_bg"
            android:elevation="0dp"
            android:paddingStart="@dimen/spacing_lg"
            android:paddingEnd="@dimen/spacing_sm"
            app:title="@string/app_name"
            app:titleTextAppearance="@style/NotionTextAppearance.TitleLarge"
            app:titleTextColor="@color/toolbar_title"
            app:menu="@menu/menu_main" />

        <!-- Subtle divider line below toolbar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/notion_divider" />

        <!-- ============================================== -->
        <!-- Search Bar                                     -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/search_height"
            android:layout_marginStart="@dimen/screen_padding_horizontal"
            android:layout_marginEnd="@dimen/screen_padding_horizontal"
            android:layout_marginTop="@dimen/spacing_md"
            android:layout_marginBottom="@dimen/spacing_sm"
            android:background="@drawable/bg_search_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_sm">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:contentDescription="@string/search_hint"
                android:importantForAccessibility="no" />

            <EditText
                android:id="@+id/etSearch"
                android:importantForAutofill="no"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:textColorHint="@color/search_hint"
                android:textColor="@color/notion_text_default"
                android:textSize="@dimen/text_body_small"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="@dimen/spacing_sm"
                android:paddingEnd="@dimen/spacing_sm"
                android:fontFamily="sans-serif" />

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:contentDescription="@string/cd_clear_search"
                android:padding="10dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ============================================== -->
        <!-- Category Filter Chips                          -->
        <!-- ============================================== -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:clipToPadding="false"
            android:layout_marginBottom="4dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:chipSpacingHorizontal="@dimen/spacing_sm">

                <!-- "All" chip — default selected -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/NotionFilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category_all"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPersonal"
                    style="@style/NotionFilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category_personal" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWork"
                    style="@style/NotionFilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category_work" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCollege"
                    style="@style/NotionFilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category_college" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipShopping"
                    style="@style/NotionFilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category_shopping" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipIdeas"
                    style="@style/NotionFilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/category_ideas" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Result count header -->
        <TextView
            android:id="@+id/tvNotesCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="4dp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/notion_text_tertiary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="12 notes"
            tools:visibility="visible" />

        <!-- ============================================== -->
        <!-- Content Area (RecyclerView + Empty State)      -->
        <!-- ============================================== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Notes RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNotes"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="96dp"
                android:scrollbars="none"
                tools:listitem="@layout/item_note" />

            <!-- Empty State (shown when no notes exist) -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/empty_icon_size"
                    android:layout_height="@dimen/empty_icon_size"
                    android:src="@drawable/ic_notes_empty"
                    android:contentDescription="@string/cd_empty_state"
                    android:alpha="0.6" />

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="@string/empty_state_title"
                    android:textColor="@color/notion_text_default"
                    android:textSize="@dimen/text_title_medium"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tvEmptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/empty_state_subtitle"
                    android:textColor="@color/notion_text_tertiary"
                    android:textSize="@dimen/text_body_small"
                    android:fontFamily="sans-serif" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEmptyAction"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:text="@string/empty_cta" />
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- ============================================== -->
    <!-- Floating Action Button                         -->
    <!-- ============================================== -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddNote"
        style="@style/NotionExtendedFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        android:contentDescription="@string/cd_add_note"
        android:text="@string/fab_new_note"
        app:icon="@drawable/ic_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
