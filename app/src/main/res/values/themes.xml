<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- ============================================== -->
    <!-- Notion Light Theme (Material3)                 -->
    <!-- ============================================== -->
    <style name="Theme.NotesApp" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color — Notion's dark warm gray -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>

        <!-- Secondary — Notion blue for accents -->
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>

        <!-- Surface — clean Notion white -->
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/colorOnSurfaceVariant</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="colorOnBackground">@color/colorOnBackground</item>

        <!-- Error -->
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorOnError</item>

        <!-- Outline / Divider -->
        <item name="colorOutline">@color/colorOutline</item>

        <!-- Status Bar — white in light mode -->
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Window background -->
        <item name="android:windowBackground">@color/colorBackground</item>

        <!-- Text appearance overrides for Notion-style typography -->
        <item name="textAppearanceHeadlineLarge">@style/NotionTextAppearance.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/NotionTextAppearance.HeadlineMedium</item>
        <item name="textAppearanceTitleLarge">@style/NotionTextAppearance.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/NotionTextAppearance.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/NotionTextAppearance.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/NotionTextAppearance.BodyMedium</item>
        <item name="textAppearanceLabelLarge">@style/NotionTextAppearance.LabelLarge</item>
        <item name="textAppearanceLabelSmall">@style/NotionTextAppearance.LabelSmall</item>
    </style>

    <!-- ============================================== -->
    <!-- Notion Typography Styles                       -->
    <!-- ============================================== -->
    <style name="NotionTextAppearance.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/notion_text_default</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="NotionTextAppearance.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/notion_text_default</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="NotionTextAppearance.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/notion_text_default</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="NotionTextAppearance.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/notion_text_default</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="NotionTextAppearance.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/notion_text_default</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="NotionTextAppearance.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/notion_text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="NotionTextAppearance.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/notion_text_default</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="NotionTextAppearance.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/notion_text_tertiary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- ============================================== -->
    <!-- Component Styles                               -->
    <!-- ============================================== -->

    <!-- Notion-styled Card -->
    <style name="NotionCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Notion-styled FAB -->
    <style name="NotionExtendedFab" parent="Widget.Material3.ExtendedFloatingActionButton.Primary">
        <item name="backgroundTint">@color/fab_bg</item>
        <item name="iconTint">@color/fab_icon</item>
        <item name="android:textColor">@color/fab_icon</item>
        <item name="shapeAppearanceOverlay">@style/NotionFabShape</item>
    </style>

    <style name="NotionFabShape" parent="">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Notion-styled TextInputLayout -->
    <!-- Notion-styled Toolbar -->
    <!-- Category Chip Style -->
    <style name="NotionChip" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">4dp</item>
        <item name="chipMinHeight">24dp</item>
        <item name="chipMinTouchTargetSize">0dp</item>
        <item name="textStartPadding">8dp</item>
        <item name="textEndPadding">8dp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <!-- Filter Chip Style -->
    <style name="NotionFilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">6dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/colorOutline</item>
        <item name="android:textSize">13sp</item>
        <item name="chipBackgroundColor">@color/chip_unselected_bg</item>
        <item name="android:textColor">@color/chip_unselected_text</item>
        <item name="checkedIconVisible">false</item>
    </style>
</resources>
